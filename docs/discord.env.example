# Protected file. Replace all paths for your host; use an independent service key.
AUTH_MODE=tunnel-service
BRIDGE_MODE=tunnel
TUNNEL_SERVICE_OPERATION=live
TUNNEL_SERVICE_OWNER_ID=tunnel-owner:dot-bridge
HOST=127.0.0.1
PORT=8793
TUNNEL_SERVICE_KEY_FILE=/etc/dot-bridge/discord/service-key
DISCORD_CREDENTIALS_FILE=/etc/dot-bridge/discord/credentials.json
STORAGE_KEY_FILE=/etc/dot-bridge/discord/storage-key
DATABASE_PATH=/var/lib/dot-bridge/discord/messages.sqlite
BRIDGE_LOCK_DIRECTORY=/var/lib/dot-bridge/locks
CALLBACK_TRANSPORT_MODE=standard
# Set CALLBACK_HOSTS to the exact domain supplied by the original dot's real subscription.
# Never copy a callback domain from another deployment or use a wildcard.
